+        c.check(decisions.len() == 1, &format!("恰好 1 条决策（实际 {}）", decisions.len()));
+        let first = decisions.first().map(|s| s.as_str()).unwrap_or_default();
+        c.check(first.starts_with("decision:region_select"), "decision_kind 是 region_select");
