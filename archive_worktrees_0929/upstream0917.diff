+            "pt_favor_rate=1.0 重建: score={score_at_rate_one} score_pt={score_pt_at_rate_one} 差额={gap}（Hint 折算 PT={hint_pt}）"
+        );
+        c.check(hint_pt > 0, "构造的状态确实有非零 Hint 折算 PT");
+        c.check(
+            gap != 0.0,
+            "❗pt_favor_rate = 1.0 下 score 仍然 ≠ score_pt —— 不能用「倍率调成 1」冒充切回 Score 轴"
+        );
+        c.finish()
+    }
+
+    /// 合成候选：Score 轴与 PT 轴选出不同赢家，且统计量各不相同
+    ///
+    /// 不依赖自然样本碰巧同赢家：直接构造 `(score, score_pt)` 两列，
+    /// 让 `mean(.0)` 与 `weighted_mean(rf)(.1)` 的 argmax 落在不同候选上。
+    /// 这是「选择、平局打破、理由/摘要必须逐项注明轴与统计量」的最小反例覆盖。
+    #[test]
+    fn test_two_axes_can_pick_different_winners() {
+        let mk = |scores: &[f64], pts: &[f64]| {
+            let mut a = ActionResult::new();
+            let mut b = ActionResult::new();
+            for &s in scores {
+                a.add(s);
+            }
+            for &p in pts {
+                b.add(p);
+            }
+            (a, b)
+        };
+        // 候选 0：score 均值高、score_pt 分布平；候选 1：score 略低、score_pt 有高尾
+        let results = vec![
+            mk(&[70000.0, 70000.0, 70000.0, 70000.0], &[40000.0, 40000.0, 40000.0, 40000.0]),
+            mk(&[69000.0, 69000.0, 69000.0, 69000.0], &[10000.0, 10000.0, 10000.0, 90000.0])
+        ];
+        let rf = 1.4;
+        let out: SearchOutput<usize> = SearchOutput::new(vec![0usize, 1], results, rf);
+
+        let score_means: Vec<f64> = out.action_results.iter().map(|(s, _)| s.mean()).collect();
+        let pt_weighted: Vec<f64> = out
+            .action_results
+            .iter()
+            .map(|(_, p)| p.weighted_mean(rf))
+            .collect();
+        let pt_means: Vec<f64> = out.action_results.iter().map(|(_, p)| p.mean()).collect();
+        println!("score.mean={score_means:?}");
+        println!("score_pt.mean={pt_means:?}  score_pt.weighted_mean({rf})={pt_weighted:?}");
+        println!(
+            "best_action_idx(Score 轴)={} best_action_pt_idx(PT 轴)={}",
+            out.best_action_idx,
+            out.best_action_pt_idx()
+        );
+        let mut c = Checks::new();
+        c.check(out.best_action_idx == 0, "Score 轴（mean of .0）选候选 0");
+        c.check(out.best_action_pt_idx() == 1, "PT 轴（weighted_mean(rf) of .1）选候选 1");
+        // 同一列上 mean 与 weighted_mean 是两个统计量：拿 mean 当 PT 轴的平局判据会错
+        c.check(
+            pt_means[0] > pt_means[1] && pt_weighted[0] < pt_weighted[1],
+            "同一 .1 列上 mean 与 weighted_mean(rf) 排序相反 ⇒ 平局判据必须跟随真正的选择键"
+        );
+        let _ = c.finish();
+    }
+}
