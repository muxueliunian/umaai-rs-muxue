+            // 这一个字段，等价于两种规则各自的落地结果，且不引入 distribute 的随机流差异。
+            game.ramen.train_feeling_type = if 落库 {
+                // 整合**前**的语义：72–77 同样把抽到的角标写进状态
+                Some([super::super::FeelingType::A; 5])
+            } else {
