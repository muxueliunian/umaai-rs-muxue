+    /// 结果类型标记（进 CSV，绝不让叶伪装成终局）
+    fn kind(&self) -> &'static str {
+        match self {
+            TrajOutcome::Terminal { .. } => "terminal",
+            TrajOutcome::Leaf(_) => "leaf"
+        }
+    }
