+/// 生产 rf=0 与本工具均值选择器的对拍
+#[derive(Debug, Clone, Serialize)]
+struct MeanCheck {
+    /// 生产路径在 `radical_factor_max=0` 下的选中下标
+    prod_best: usize,
+    /// 本工具均值选择器的选中下标
+    bench_best: usize,
+    /// 两边各候选均值的最大绝对差
+    max_abs_diff: f64,
+    /// 两边各候选均值是否**逐位**相同
+    bitwise_equal: bool
+}
