+    }
+    let mut pick = BATCH_TIERS[0].min(max_batch).max(1);
+    for t in BATCH_TIERS {
+        if t <= max_batch && t <= total_rollouts && t > pick {
+            pick = t;
+        }
+    }
+    pick
