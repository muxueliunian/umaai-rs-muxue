+        let mut c = Checks::new();
+        c.check(before.len() == after.len() && before.len() == super::INPUT_DIM, "两次编码都是 754 维");
+        c.check(
+            !diffs.is_empty(),
+            "❗72–77 角标语义变化**确实**改变 NN 输入 —— 手写单根分数一致不能证明 NN 行为一致"
+        );
+        c.finish()
+    }
+}
