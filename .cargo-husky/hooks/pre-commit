#!/usr/bin/env bash
# pre-commit：rustfmt 格式检查（由 cargo-husky 分发到 .git/hooks）
#
# 规则对齐 AGENTS.md：项目使用 Nightly 格式规则，stable 下禁止执行 cargo fmt（会搞乱格式）。
# 因此：本机有 nightly 工具链 → 用 `cargo +nightly fmt --all -- --check` 检查；
#       无 nightly → 跳过检查（不阻塞提交）。
# `--check` 只读不改文件，永远安全。
set -euo pipefail

if rustup toolchain list 2>/dev/null | grep -q nightly; then
  if ! cargo +nightly fmt --all -- --check; then
    echo "❌ rustfmt 检查未通过：请先运行 cargo +nightly fmt --all 再提交"
    exit 1
  fi
  echo "✅ rustfmt（nightly）检查通过"
else
  echo "⚠️ 未检测到 nightly 工具链，跳过 rustfmt 检查（stable 下不做 fmt）"
fi
exit 0
